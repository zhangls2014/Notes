# Default ignored files
/shelf/
/workspace.xml
/deploymentTargetSelector.xml
/deviceManager.xml

# IDE 本机专属文件：由 Gradle 同步推导，或记录个人偏好/本机环境，不应随仓库分发。
# 构建参数（jvmTarget、字节码版本等）的唯一来源是 build-logic 约定插件与 gradle/kmp.versions.toml。
/AndroidProjectSystem.xml
/compiler.xml
/detekt.xml
/icon.svg
/kotlinc.xml
/markdown.xml
/migrations.xml
/misc.xml
/studiobot.xml

# 由 Gradle 同步推导 / IDE 自动生成的工程文件
# （原先散落在仓库根 .gitignore，统一收敛到此处，避免两处维护同一件事）
/artifacts
/assetWizardSettings.xml
/caches
/gradle.xml
/inspectionProfiles/Project_Default.xml
/libraries
/modules.xml
/navEditor.xml
/valkyrie_settings.xml
/xcode.xml
